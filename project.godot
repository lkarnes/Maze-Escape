;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Maze-Escape"
run/main_scene="res://scenes/MainMenu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Maze="*res://scripts/maze/maze.gd"
SteamManager="*res://scripts/multiplayer/steam/steam_manager.gd"
SteamNetwork="*res://scripts/multiplayer/networks/steam_network.gd"
MultiplayerManager="*res://scripts/multiplayer/multiplayer_manager.gd"
NetworkManager="*res://scripts/multiplayer/networks/network_manager.gd"
World="*res://scenes/World/world.gd"
Maze1="*res://scenes/Maze/maze1.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=false

